# ============================================================
#  image-studio - 环境配置模板（复制为 .env 后按需修改）
# ============================================================

# ---------- 服务 ----------
HOST=127.0.0.1
PORT=8030

# ---------- 运行模式 ----------
# mock  = 占位出图（不依赖 ComfyUI，验证流程）
# comfy = ComfyUI 引擎真实出图（推荐）
ENGINE_MODE=comfy

# ---------- ComfyUI 引擎 ----------
# 共享模式：ComfyUI 由 comfy-service 常驻提供，本应用只连接不管理
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_SHARED=true

# ---------- 模型（文件名以 ComfyUI object_info 可见列表为准） ----------
TRANSFORMER_FILE=qwen-image-2.1-UC-Q4_K_M.gguf
TEXT_ENCODER_FILE=qwen3vl_8b_int8_convrot.safetensors
VAE_FILE=qwen_image_2.1_vae_bf16.safetensors

# ---------- 生成默认值 ----------
DEFAULT_WIDTH=768
DEFAULT_HEIGHT=768
DEFAULT_STEPS=8
DEFAULT_GUIDANCE=4.0
MAX_BATCH=4
INFER_TIMEOUT_SECONDS=2400
MAX_QUEUE_SIZE=20

# ---------- 存储 ----------
DATA_DIR=data
OUTPUT_DIR=data/outputs
DB_PATH=data/app.db
MAX_OUTPUT_DIR_GB=50
